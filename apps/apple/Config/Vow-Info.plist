<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Connect to your Ledger Nano X, Nano Gen5 or Flex to verify its account and approve signing requests. Vow does not use Bluetooth for internet access.</string>
	<key>VowNativeSecurityKeyDomain</key>
	<string>$(VOW_WEBAUTHN_RP_ID)</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Vow transaction</string>
			<key>CFBundleTypeIconFile</key>
			<string>VowDocument.icns</string>
			<key>CFBundleTypeIconFiles</key>
			<array>
				<string>VowDocument64.png</string>
				<string>VowDocument320.png</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.vow.transaction</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Solana transaction dump</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.json</string>
				<string>public.plain-text</string>
				<string>public.data</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Vow transaction</string>
			<key>UTTypeIconFile</key>
			<string>VowDocument.icns</string>
			<key>UTTypeIconFiles</key>
			<array>
				<string>VowDocument64.png</string>
				<string>VowDocument320.png</string>
			</array>
			<key>UTTypeIdentifier</key>
			<string>org.vow.transaction</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>vow</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.vow+json</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
